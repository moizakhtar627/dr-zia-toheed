ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=generate_with_bcrypt_12
SESSION_SECRET=change_this_long_random_string
PORT=3000
PUBLIC_READ_ONLY=0
# Supabase (server only - never expose service role key to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ADMIN_EMAIL=your_admin_email@example.com
# For reference only if frontend uses it (prefer server env vars)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

