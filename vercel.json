{
  "version": 2,
  "buildCommand": "npm rebuild sqlite3 --build-from-source",
  "installCommand": "npm ci",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server.js",
          "supabase-client.js",
          "style.css",
          "script.js",
          "home-meds.js",
          "books-data.js",
          "books-home.js",
          "pharmacy.js",
          "read-book.js",
          "admin.js",
          "medicine-example.svg",
          "dr.zia.png",
          "*.html",
          "covers/**",
          "uploads/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
